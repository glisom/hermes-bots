#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: $0 <team-name>" >&2
  exit 2
}

TEAM="${1:-}"
[[ -n "$TEAM" ]] || usage

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROFILE_LIST="$ROOT/teams/$TEAM/profiles.txt"
[[ -f "$PROFILE_LIST" ]] || {
  echo "unknown team: $TEAM" >&2
  exit 1
}

while IFS= read -r profile; do
  [[ -n "$profile" ]] || continue
  "$ROOT/bin/update-bot" "$profile"
done < "$PROFILE_LIST"

echo "Updated team: $TEAM"
